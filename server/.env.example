# Токен от @BotFather. Без него бот и рассылка не стартуют, ссылки из приложения всё равно можно выдавать.
BOT_TOKEN=
# Имя бота без @. Оно попадает в https://t.me/<имя>?start=<токен>
BOT_USERNAME=

# Ключ xAI. Если пусто, уходит запасной текст из карточек недель, без вызова Grok.
GROK_API_KEY=
GROK_MODEL=grok-4.7

# 32 байта в base64url. Шифрует дату месячных в SQLite.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DATA_KEY=

# Файл базы. Каталог создаётся сам.
DB_PATH=./data/bot.sqlite

PORT=8787
# Через запятую, без слэша в конце. Откуда открыто приложение.
APP_ORIGIN=http://127.0.0.1:5173

# Сколько живёт одноразовая ссылка из приложения.
TOKEN_TTL_MS=900000
# Как часто процесс смотрит, кому пора писать.
TICK_MS=30000
